# Formora Production Environment Configuration
NODE_ENV=production
PORT=3001

# Security & Session Signing (REQUIRED in production, >= 32 random chars)
JWT_SECRET=replace-with-a-64-char-cryptographically-random-secret-string
CORS_ORIGIN=https://app.formora.dev
FRONTEND_URL=https://app.formora.dev

# Database Storage (Relational SQLite WAL path; defaults to server/data/formora.sqlite)
DATABASE_PATH=./server/data/formora.sqlite

# Lemon Squeezy Merchant-of-Record SaaS Billing
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_TEAM_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_TEAM_YEARLY_VARIANT_ID=

# ==============================================================================
# Server-Managed AI Architect Configuration (Primary SaaS Default)
# Users NEVER need to enter their own API key when Server AI is configured here.
# Supported AI_PROVIDER values:
#   gemini | openai | anthropic | openrouter | groq | deepseek | ollama | custom
# Falls back automatically to the built-in Blueprint Engine if unset.
# ==============================================================================
AI_PROVIDER=
AI_MODEL=
AI_MODELS=
AI_API_KEY=

# Custom OpenAI-Compatible or Anthropic-Compatible Endpoint (LiteLLM, vLLM, OpenRouter, Cloudflare AI Gateway, Ollama, etc.)
AI_BASE_URL=
AI_PROTOCOL=openai
AI_CUSTOM_HEADERS=

# Or set provider-specific keys (auto-detected if AI_PROVIDER is blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# SaaS Policy: Allow users to override Server AI with their own key or custom endpoint?
# Set to false in strict SaaS production so 100% of requests use your Server AI.
ALLOW_USER_LLM_CONFIG=true
ALLOW_LOCAL_LLM_ENDPOINTS=false
SEED_DEMO_DATA=false
