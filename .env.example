# Skemat Production Environment Configuration (skemat.online)
NODE_ENV=production
PORT=3001

# Security & Session Signing (REQUIRED in production, >= 32 random chars)
JWT_SECRET=replace-with-a-64-char-cryptographically-random-secret-string
CORS_ORIGIN=https://skemat.online,https://app.skemat.online
FRONTEND_URL=https://skemat.online

# Database Storage (Relational SQLite WAL path; defaults to server/data/skemat.sqlite)
DATABASE_PATH=./server/data/skemat.sqlite

# Google OAuth (Direct Sign-In with Google for Skemat)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SaaS Billing Provider: Blink (sellonblink.com / blink.store)
BILLING_PROVIDER=blink

# Blink Digital Checkout (sellonblink.com / blink.store)
BLINK_PRO_MONTHLY_URL=https://blink.store/p/your-pro-monthly-id
BLINK_PRO_YEARLY_URL=https://blink.store/p/your-pro-yearly-id
BLINK_TEAM_MONTHLY_URL=https://blink.store/p/your-team-monthly-id
BLINK_TEAM_YEARLY_URL=https://blink.store/p/your-team-yearly-id
BLINK_WEBHOOK_SECRET=

# ==============================================================================
# Server-Managed AI Architect Configuration (Primary SaaS Default)
# Users NEVER need to enter their own API key when Server AI is configured here.
# Supported AI_PROVIDER values:
#   gemini | openai | anthropic | openrouter | groq | deepseek | ollama | custom
# Falls back automatically to the built-in Blueprint Engine if unset.
# ==============================================================================
AI_PROVIDER=
AI_MODEL=
AI_MODELS=
AI_API_KEY=

# Custom OpenAI-Compatible or Anthropic-Compatible Endpoint (LiteLLM, vLLM, OpenRouter, Cloudflare AI Gateway, Ollama, etc.)
AI_BASE_URL=
AI_PROTOCOL=openai
AI_CUSTOM_HEADERS=

# Or set provider-specific keys (auto-detected if AI_PROVIDER is blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# SaaS Policy: Allow users to override Server AI with their own key or custom endpoint?
# Set to false in strict SaaS production so 100% of requests use your Server AI.
ALLOW_USER_LLM_CONFIG=true
ALLOW_LOCAL_LLM_ENDPOINTS=false
SEED_DEMO_DATA=false
